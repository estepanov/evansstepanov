---
import '../app.css';
import ThemeToggle from '../components/chrome/ThemeToggle.svelte';

interface Props {
	title?: string;
}

const { title = 'Evans Stepanov' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				var root = document.documentElement;
				root.classList.add('js');
				try {
					var stored = localStorage.getItem('theme');
					var mode = stored === 'light' || stored === 'dark' ? stored : 'system';
					var dark =
						mode === 'dark' ||
						(mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
					root.classList.toggle('dark', dark);
					root.style.colorScheme = dark ? 'dark' : 'light';
					root.dataset.themeMode = mode;
				} catch (e) {}
			})();
		</script>
		<link rel="icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
		<link
			rel="preload"
			href="https://fonts.bunny.net/albert-sans/files/albert-sans-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="https://fonts.bunny.net/albert-sans/files/albert-sans-latin-500-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="https://fonts.bunny.net/albert-sans/files/albert-sans-latin-600-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			href="https://fonts.bunny.net/css?family=albert-sans:400,500,600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-slate-800 focus:shadow-lg dark:focus:bg-slate-900 dark:focus:text-slate-100"
		>
			Skip to content
		</a>
		<slot />
		<ThemeToggle client:load />
		<script>
			import * as Fathom from 'fathom-client';

			const siteId = import.meta.env.PUBLIC_FATHOM_SITE_ID;
			if (siteId) {
				Fathom.load(siteId);
			}

			const root = document.documentElement;
			let idleTimer: ReturnType<typeof setTimeout> | undefined;
			let rafPending = false;

			const markIdle = () => {
				root.classList.remove('is-scrolling');
			};

			const onScroll = () => {
				if (rafPending) return;
				rafPending = true;
				requestAnimationFrame(() => {
					rafPending = false;
					if (!root.classList.contains('is-scrolling')) {
						root.classList.add('is-scrolling');
					}
					clearTimeout(idleTimer);
					idleTimer = setTimeout(markIdle, 500);
				});
			};

			window.addEventListener('scroll', onScroll, { passive: true });
		</script>
	</body>
</html>
