---
import { ArrowUpRight, House, Table } from '@lucide/svelte';
import AnchorButton from '../../components/actions/AnchorButton.svelte';
import ButtonContainer from '../../components/actions/ButtonContainer.svelte';
import TechHeader from '../../components/domain/tech/TechHeader.svelte';
import TechIcon from '../../components/domain/tech/TechIcon.svelte';
import TopicHero from '../../components/domain/tech/TopicHero.svelte';
import ProjectCard from '../../components/domain/work/ProjectCard.svelte';
import WorkExperienceCard from '../../components/domain/work/WorkExperienceCard.svelte';
import PageContainer from '../../components/layout/PageContainer.svelte';
import StickySectionHeader from '../../components/layout/StickySectionHeader.svelte';
import { TechProficiency } from '../../data/tech';
import Base from '../../layouts/Base.astro';
import {
	hydrateCollection,
	loadPublished,
	mergeCacheHints,
	projectFromEntry,
	publishedCompanyViews,
	publishedTech
} from '../../util/emdash-content';
import { getTechIcon } from '../../util/tech-icons';
import {
	relatedCompaniesForTech,
	relatedProjectsForTech,
	resolveTechPage
} from '../../util/tech-page';

const page = await resolveTechPage(Astro.params.slug);
if (!page) return Astro.rewrite('/404');

const [companiesResult, rolesResult, projectsResult, techResult] = await Promise.all([
	loadPublished('companies'),
	loadPublished('roles'),
	loadPublished('projects'),
	loadPublished('tech')
]);
const hydratedRoles = await hydrateCollection('roles', rolesResult, {
	company: true,
	tech: true
});
const hydratedProjects = await hydrateCollection('projects', projectsResult, { tech: true });

if (Astro.cache.enabled) {
	Astro.cache.set(
		mergeCacheHints(
			page.cacheHint,
			companiesResult.cacheHint,
			hydratedRoles.cacheHint,
			hydratedProjects.cacheHint,
			techResult.cacheHint
		)
	);
}

const { tech } = page;
const techIcon = getTechIcon(tech.name);
const techItems = techResult.entries
	.map(publishedTech)
	.filter((item): item is NonNullable<typeof item> => Boolean(item?.name));
const techForCards = techItems.map((item) => ({
	name: item.name,
	slug: item.slug,
	type: item.type,
	proficiencyWeight: item.proficiencyWeight
}));
const relatedWork = relatedCompaniesForTech(
	tech.name,
	publishedCompanyViews(companiesResult.entries, hydratedRoles.entries)
);
const relatedProjects = relatedProjectsForTech(
	tech.name,
	hydratedProjects.entries.map(projectFromEntry).filter((project) => project.name)
);

function proficiencyTone(proficiency: TechProficiency): string {
	switch (proficiency) {
		case TechProficiency.Beginner:
			return 'text-mist-500 dark:text-mist-400';
		case TechProficiency.Intermediate:
			return 'text-iris-600 dark:text-iris-400';
		case TechProficiency.Advanced:
			return 'text-iris-700 dark:text-iris-300';
		case TechProficiency.Expert:
			return 'text-iris-800 dark:text-iris-200';
		default: {
			const _exhaustive: never = proficiency;
			return _exhaustive;
		}
	}
}
---

<Base
	title={`${tech.name} - Evans Stepanov`}
	description={tech.description || `Learn about ${tech.name} and my experience with it.`}
>
	<PageContainer class="mt-10 space-y-16">
		<TechHeader rootHref="/tech/" leaf={tech.name} />

		<main id="main-content" class="w-full">
			<TopicHero tags={[tech.name]}>
				<div class="flex items-center justify-between gap-4">
					{
						tech.type && (
							<span class="text-[10px] font-semibold tracking-[0.22em] uppercase text-mist-500 dark:text-mist-400">
								{tech.type}
							</span>
						)
					}
					{
						tech.url && (
							<a
								href={tech.url}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-1.5 text-[11px] font-medium tracking-[0.12em] uppercase text-jade-700 dark:text-jade-400 hover:text-jade-800 dark:hover:text-jade-300 transition-colors group"
							>
								<span class="underline underline-offset-4 decoration-jade-600/30 group-hover:decoration-jade-600">
									Learn more
								</span>
								<ArrowUpRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
							</a>
						)
					}
				</div>

				<div class="flex items-start gap-5 md:gap-7">
					{
						techIcon && (
							<span class="hero-icon shrink-0 inline-flex items-center justify-center w-16 h-16 md:w-20 md:h-20 rounded-xl bg-white/70 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 text-slate-800 dark:text-slate-100 shadow-xs backdrop-blur-sm">
								<TechIcon icon={techIcon} size={44} />
							</span>
						)
					}
					<div class="min-w-0 flex-1">
						<h1
							class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight text-slate-900 dark:text-slate-100 leading-[1.05]"
						>
							{tech.name}
						</h1>
						{
							tech.proficiency && (
								<div class="mt-4 flex items-center gap-3 flex-wrap">
									<span class="text-[10px] font-semibold tracking-[0.22em] uppercase text-mist-500 dark:text-mist-400">
										Proficiency
									</span>
									<span
										class="inline-block h-3 w-px bg-slate-300 dark:bg-slate-700"
										aria-hidden="true"
									/>
									<span
										class={`text-[11px] md:text-xs font-semibold tracking-[0.22em] uppercase ${proficiencyTone(tech.proficiency)}`}
										aria-label={`Proficiency: ${tech.proficiency}`}
									>
										{tech.proficiency}
									</span>
								</div>
							)
						}
					</div>
				</div>

				{
					tech.description && (
						<p class="max-w-2xl text-base md:text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
							{tech.description}
						</p>
					)
				}
			</TopicHero>

			{
				relatedWork.length > 0 && (
					<section class={relatedProjects.length > 0 ? 'pb-20' : ''}>
						<StickySectionHeader>
							<h2 class="section-title text-2xl font-semibold tracking-[0.18em] uppercase text-slate-700 dark:text-slate-300">
								Related Work
							</h2>
						</StickySectionHeader>
						<ul class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 lg:gap-12 relative">
							{relatedWork.map((work) => (
								<WorkExperienceCard item={work} />
							))}
						</ul>
					</section>
				)
			}

			{
				relatedProjects.length > 0 && (
					<section>
						<StickySectionHeader>
							<h2 class="section-title text-2xl font-semibold tracking-[0.18em] uppercase text-slate-700 dark:text-slate-300">
								Related Projects
							</h2>
						</StickySectionHeader>
						<ul class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 lg:gap-12 relative">
							{relatedProjects.map((project) => (
								<ProjectCard client:idle item={project} tech={techForCards} />
							))}
						</ul>
					</section>
				)
			}
		</main>

		<div class="w-full mt-10 mb-20">
			<ButtonContainer>
				<AnchorButton href="/">
					<House />
					Back to Home
				</AnchorButton>
				<AnchorButton href="/tech/">
					<Table />
					View all Tech
				</AnchorButton>
			</ButtonContainer>
		</div>
	</PageContainer>
</Base>
