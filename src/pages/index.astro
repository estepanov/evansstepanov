---
import { getEmDashEntry, type CacheHint, type ContentEntry } from 'emdash';
import { PortableText, type PortableTextBlock } from 'emdash/ui';
import Base from '../layouts/Base.astro';
import Logo from '../components/chrome/Logo.svelte';
import FooterQuote from '../components/chrome/FooterQuote.svelte';
import PageContainer from '../components/layout/PageContainer.svelte';
import StickySectionHeader from '../components/layout/StickySectionHeader.svelte';
import LinksSection from '../components/domain/links/LinksSection.svelte';
import ProjectCard from '../components/domain/work/ProjectCard.svelte';
import WorkExperienceCard from '../components/domain/work/WorkExperienceCard.svelte';
import TechIcon from '../components/domain/tech/TechIcon.svelte';
import ProfileDiamond from '../components/media/ProfileDiamond.svelte';
import { TECH_TYPE_ORDER, type TechType } from '../data/tech';
import type { Project } from '../data/projects';
import {
	loadHomePage,
	loadPublished,
	mergeCacheHints,
	publishedCompanyViews,
	publishedTech
} from '../util/emdash-content';
import { workFromCompanyView } from '../util/company-from-roles';
import { idHash } from '../util/id-hash-link-format';
import { normalizeExternalLink, type ExternalLink } from '../util/links';
import { getTechIcon } from '../util/tech-icons';
import { isUrlSlug } from '../util/to-url-slug';
import type { Quote } from '../components/chrome/pick-random-quote';

const EDISON_QUOTE: Quote = {
	text: "I have not failed. I've just found 10,000 ways that won't work.",
	attribution: 'Thomas A. Edison'
};

function asString(value: unknown): string {
	return typeof value === 'string' ? value : '';
}

function asDate(value: unknown): Date | undefined {
	if (value instanceof Date && !Number.isNaN(value.getTime())) return value;
	if (typeof value === 'string' && value) {
		const date = new Date(value);
		return Number.isNaN(date.getTime()) ? undefined : date;
	}
	return undefined;
}

function dataOf(entry: ContentEntry): Record<string, unknown> {
	return entry.data as Record<string, unknown>;
}

async function hydrateCollection(
	name: 'roles' | 'projects',
	published: { entries: ContentEntry[]; cacheHint: CacheHint },
	references: { company?: true; tech?: true }
): Promise<{ entries: ContentEntry[]; cacheHint: CacheHint }> {
	if (published.entries.length === 0) return published;
	const hints: CacheHint[] = [published.cacheHint];
	const entries: ContentEntry[] = [];
	const results = await Promise.all(
		published.entries.map((entry) => getEmDashEntry(name, entry.id, { references }))
	);
	for (const result of results) {
		if (result.error) throw result.error;
		if (result.cacheHint) hints.push(result.cacheHint);
		if (result.entry) entries.push(result.entry);
	}
	return { entries, cacheHint: mergeCacheHints(...hints) };
}

function projectFromEntry(entry: ContentEntry): Project {
	const data = dataOf(entry);
	const slug = asString(data.slug) || entry.id;
	const techTags = (entry.references?.tech?.entries ?? [])
		.map((tech) => asString(dataOf(tech).name).trim())
		.filter(Boolean);
	return {
		slug: isUrlSlug(slug) ? slug : undefined,
		name: asString(data.name),
		description: asString(data.description),
		url: asString(data.url),
		source: asString(data.source),
		isActive: data.is_active === true,
		startDate: asDate(data.start_date),
		endDate: asDate(data.end_date),
		media: [],
		techTags
	};
}

const [
	home,
	linksResult,
	companiesResult,
	rolesResult,
	projectsResult,
	techResult,
	quotesResult
] = await Promise.all([
	loadHomePage(),
	loadPublished('links'),
	loadPublished('companies'),
	loadPublished('roles'),
	loadPublished('projects'),
	loadPublished('tech'),
	loadPublished('quotes')
]);

const hydratedRoles = await hydrateCollection('roles', rolesResult, {
	company: true,
	tech: true
});
const hydratedProjects = await hydrateCollection('projects', projectsResult, { tech: true });

if (Astro.cache.enabled) {
	Astro.cache.set(
		mergeCacheHints(
			home.cacheHint,
			linksResult.cacheHint,
			companiesResult.cacheHint,
			hydratedRoles.cacheHint,
			hydratedProjects.cacheHint,
			techResult.cacheHint,
			quotesResult.cacheHint
		)
	);
}

const about = Array.isArray(dataOf(home.entry).about)
	? (dataOf(home.entry).about as PortableTextBlock[])
	: [];

const links = linksResult.entries
	.map((entry) => {
		const data = dataOf(entry);
		return normalizeExternalLink({ title: asString(data.title), url: asString(data.url) });
	})
	.filter((link): link is ExternalLink => Boolean(link));

const workCards = publishedCompanyViews(companiesResult.entries, hydratedRoles.entries).map(
	workFromCompanyView
);

const techItems = techResult.entries.map(publishedTech).filter((tech) => tech.name);
const presentTypes = new Set(
	techItems.map((tech) => tech.type).filter((type): type is TechType => Boolean(type))
);
const techTypes = [
	...TECH_TYPE_ORDER.filter((type) => presentTypes.has(type)),
	...[...presentTypes].filter((type) => !TECH_TYPE_ORDER.includes(type)).sort()
];
const techRows = techTypes
	.map((techType, rowIdx) => ({
		techType,
		rowIdx,
		items: techItems
			.filter((tech) => tech.type === techType)
			.slice()
			.sort((left, right) => right.proficiencyWeight - left.proficiencyWeight)
	}))
	.filter((row) => row.items.length > 0);

const projects = hydratedProjects.entries
	.map(projectFromEntry)
	.filter((project) => project.name)
	.sort((left, right) => {
		if (left.isActive && !right.isActive) return -1;
		if (!left.isActive && right.isActive) return 1;
		const leftTime = left.startDate?.getTime() ?? 0;
		const rightTime = right.startDate?.getTime() ?? 0;
		return rightTime - leftTime;
	});

const quotes: Quote[] = quotesResult.entries
	.map((entry) => {
		const data = dataOf(entry);
		const text = asString(data.text).trim();
		const attribution = asString(data.attribution).trim();
		if (!text || !attribution) return undefined;
		return { text, attribution };
	})
	.filter((quote): quote is Quote => Boolean(quote));

const currentYear = new Date().getFullYear();
const techForCards = techItems.map((tech) => ({ name: tech.name, type: tech.type }));
---

<Base>
	<PageContainer class="landing-page space-y-16 mt-12">
		<header
			class="landing-hero reveal-on-load space-y-5 text-slate-900 dark:text-slate-100 flex justify-center items-center flex-col"
		>
			<div class="landing-logo w-56 md:w-64">
				<Logo />
			</div>
			<h1 class="sr-only">Evans Stepanov — product-focused software engineer</h1>
		</header>
		<main id="main-content" class="w-full">
			<section class="landing-section reveal-on-load space-y-6 pb-16">
				<div class="flex items-baseline justify-between py-3">
					<h2
						class="section-title text-2xl font-semibold tracking-[0.18em] uppercase text-slate-700 dark:text-slate-300"
					>
						About
					</h2>
				</div>
				<div class="about-copy space-y-4 text-slate-700 dark:text-slate-300">
					<ProfileDiamond client:visible />
					<PortableText value={about} />
				</div>
			</section>

			<section class="landing-section reveal-on-load space-y-6 pb-16">
				<div class="flex items-baseline justify-between py-3">
					<h2
						class="section-title text-2xl font-semibold tracking-[0.18em] uppercase text-slate-700 dark:text-slate-300"
					>
						Links
					</h2>
				</div>
				<div class="link-list-motion">
					<LinksSection links={links} />
				</div>
			</section>

			<section class="landing-section reveal-ready pb-16">
				<StickySectionHeader>
					<h2
						class="section-title text-2xl font-semibold tracking-[0.18em] uppercase text-slate-700 dark:text-slate-300"
					>
						Work
					</h2>
				</StickySectionHeader>
				<ul class="landing-grid mt-6 grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 lg:gap-12">
					{workCards.map((work) => <WorkExperienceCard item={work} />)}
				</ul>
			</section>

			<section class="landing-section reveal-ready pb-16">
				<StickySectionHeader>
					<h2
						class="section-title text-2xl font-semibold tracking-[0.18em] uppercase text-slate-700 dark:text-slate-300"
					>
						Projects
					</h2>
				</StickySectionHeader>
				<ul class="landing-grid mt-6 grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 lg:gap-12">
					{
						projects.map((project) => (
							<ProjectCard item={project} idHash={idHash} tech={techForCards} />
						))
					}
				</ul>
			</section>

			<section class="landing-section reveal-ready">
				<StickySectionHeader>
					<h2
						class="section-title text-2xl font-semibold tracking-[0.18em] uppercase text-slate-700 dark:text-slate-300"
					>
						Tech
					</h2>
				</StickySectionHeader>
				<div class="tech-rows mt-6">
					{
						techRows.map(({ techType, rowIdx, items }) => (
							<div class="tech-row" style={`--item-delay: ${rowIdx * 70}ms;`}>
								<a href={`/tech/#${techType.toLowerCase()}`} class="tech-row__label">
									<span class="tech-row__label-text">{techType}</span>
									<span class="tech-row__rule" aria-hidden="true" />
								</a>
								<ul class="tech-row__items">
									{items.map((tech) => {
										const techIcon = getTechIcon(tech.name);
										const href = isUrlSlug(tech.slug) ? `/tech/${tech.slug}/` : undefined;
										const icon = techIcon ? (
											<TechIcon icon={techIcon} size={18} />
										) : (
											<span class="tech-item__fallback">{tech.name.charAt(0)}</span>
										);
										return (
											<li>
												{href ? (
													<a href={href} class="tech-item" title={tech.name}>
														<span class="tech-item__icon">{icon}</span>
														<span class="tech-item__name">{tech.name}</span>
													</a>
												) : (
													<span class="tech-item" title={tech.name}>
														<span class="tech-item__icon">{icon}</span>
														<span class="tech-item__name">{tech.name}</span>
													</span>
												)}
											</li>
										);
									})}
								</ul>
							</div>
						))
					}
				</div>
			</section>
		</main>
		<footer class="landing-footer reveal-ready mt-10">
			<div class="my-5 text-xs text-mist-500 dark:text-mist-400 text-center space-y-2">
				<FooterQuote quotes={quotes} fallback={EDISON_QUOTE} client:load />
				<p class="text-[10px] font-medium uppercase tracking-[0.18em]">
					© {currentYear} Evans Stepanov
				</p>
			</div>
		</footer>
	</PageContainer>
</Base>

<script>
	const nodes = document.querySelectorAll<HTMLElement>('.reveal-ready');
	const show = (node: HTMLElement) => {
		node.classList.add('is-visible');
	};

	if (
		!('IntersectionObserver' in window) ||
		window.matchMedia('(prefers-reduced-motion: reduce)').matches
	) {
		nodes.forEach(show);
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						show(entry.target as HTMLElement);
						observer.unobserve(entry.target);
					}
				}
			},
			{ rootMargin: '0px 0px 24% 0px', threshold: 0.01 }
		);
		nodes.forEach((node) => observer.observe(node));
	}
</script>

<style is:global>
	.landing-logo {
		position: relative;
		overflow: hidden;
		border-radius: 0.125rem;
		transform-origin: 50% 58%;
	}

	html.js .landing-hero.reveal-on-load .landing-logo {
		animation: landing-logo-in 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
		animation-delay: 40ms;
	}

	html.js .landing-section.reveal-ready:not(.is-visible) > :first-child,
	html.js .landing-section.reveal-ready:not(.is-visible) .link-list-motion li,
	html.js .landing-section.reveal-ready:not(.is-visible) .landing-grid > li,
	html.js .landing-section.reveal-ready:not(.is-visible) .tech-rows .tech-row,
	html.js .landing-footer.reveal-ready:not(.is-visible) > * {
		opacity: 0;
		transform: translateY(14px);
	}

	html.js .landing-section.reveal-ready:not(.is-visible) .tech-rows .tech-row {
		animation: none;
	}

	.landing-section.is-visible > :first-child {
		animation: landing-heading-in 460ms cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: var(--reveal-delay, 0ms);
	}

	.landing-section.is-visible .about-copy p,
	.landing-section.is-visible .link-list-motion li,
	.landing-section.is-visible .landing-grid > li,
	.landing-section.is-visible .tech-rows .tech-row,
	.landing-footer.is-visible > * {
		animation: landing-content-in 560ms cubic-bezier(0.16, 1, 0.3, 1) both;
		animation-delay: calc(var(--reveal-delay, 0ms) + var(--item-delay, 40ms));
	}

	.landing-section.reveal-on-load > :first-child {
		animation: landing-heading-slide 460ms cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: var(--reveal-delay, 0ms);
	}

	.landing-section.reveal-on-load .about-copy p,
	.landing-section.reveal-on-load .link-list-motion li {
		animation: landing-content-slide 560ms cubic-bezier(0.16, 1, 0.3, 1) both;
		animation-delay: calc(var(--reveal-delay, 0ms) + var(--item-delay, 40ms));
	}

	.about-copy p:nth-of-type(1),
	.link-list-motion li:nth-child(1),
	.landing-grid > li:nth-child(1) {
		--item-delay: 40ms;
	}

	.about-copy p:nth-of-type(2),
	.link-list-motion li:nth-child(2),
	.landing-grid > li:nth-child(2) {
		--item-delay: 80ms;
	}

	.about-copy p:nth-of-type(3),
	.link-list-motion li:nth-child(3),
	.landing-grid > li:nth-child(3) {
		--item-delay: 120ms;
	}

	.link-list-motion li:nth-child(4),
	.landing-grid > li:nth-child(4) {
		--item-delay: 160ms;
	}

	.link-list-motion li:nth-child(5),
	.landing-grid > li:nth-child(5) {
		--item-delay: 200ms;
	}

	.link-list-motion li:nth-child(6),
	.landing-grid > li:nth-child(6) {
		--item-delay: 240ms;
	}

	.landing-grid > li:nth-child(7) {
		--item-delay: 280ms;
	}

	.landing-grid > li:nth-child(8) {
		--item-delay: 320ms;
	}

	.landing-grid > li:nth-child(9) {
		--item-delay: 360ms;
	}

	.landing-grid > li:nth-child(10) {
		--item-delay: 400ms;
	}

	.landing-grid > li:nth-child(11) {
		--item-delay: 440ms;
	}

	.landing-grid > li:nth-child(12) {
		--item-delay: 480ms;
	}

	@keyframes landing-logo-in {
		0% {
			opacity: 0;
			filter: blur(8px);
			transform: translateY(10px) scale(0.97);
		}
		60% {
			opacity: 1;
		}
		100% {
			opacity: 1;
			filter: blur(0);
			transform: translateY(0) scale(1);
		}
	}

	@keyframes landing-heading-in {
		0% {
			opacity: 0;
			transform: translateY(10px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes landing-content-in {
		0% {
			opacity: 0;
			transform: translateY(14px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes landing-heading-slide {
		0% {
			transform: translateY(10px);
		}
		100% {
			transform: translateY(0);
		}
	}

	@keyframes landing-content-slide {
		0% {
			transform: translateY(14px);
		}
		100% {
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.landing-logo,
		.landing-section > :first-child,
		.about-copy p,
		.link-list-motion li,
		.landing-grid > li,
		.tech-rows .tech-row,
		.landing-footer > * {
			animation: none !important;
			filter: none !important;
			opacity: 1 !important;
			transform: none !important;
		}
	}

	.tech-rows {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.tech-row {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	.tech-row__label {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--color-mist-500);
		transition: color 200ms ease;
	}

	html.dark .tech-row__label {
		color: var(--color-mist-400);
	}

	.tech-row__label-text {
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.tech-row__rule {
		flex: 1;
		height: 1px;
		background-color: var(--color-slate-200);
		transition: background-color 200ms ease;
	}

	html.dark .tech-row__rule {
		background-color: var(--color-slate-800);
	}

	.tech-row__label:hover,
	.tech-row__label:focus-visible {
		color: var(--color-jade-700);
	}

	html.dark .tech-row__label:hover,
	html.dark .tech-row__label:focus-visible {
		color: var(--color-jade-400);
	}

	.tech-row__items {
		display: flex;
		flex-wrap: wrap;
		column-gap: 1.5rem;
		row-gap: 0.625rem;
	}

	.tech-item {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-slate-700);
		transition: color 200ms ease;
	}

	html.dark .tech-item {
		color: var(--color-slate-300);
	}

	.tech-item:hover,
	.tech-item:focus-visible {
		color: var(--color-jade-700);
	}

	html.dark .tech-item:hover,
	html.dark .tech-item:focus-visible {
		color: var(--color-jade-400);
	}

	.tech-row__label:focus-visible,
	.tech-item:focus-visible {
		outline: 2px solid var(--color-jade-700);
		outline-offset: 3px;
		border-radius: 0.25rem;
	}

	html.dark .tech-row__label:focus-visible,
	html.dark .tech-item:focus-visible {
		outline-color: color-mix(in oklab, var(--color-jade-400) 60%, transparent);
	}

	.tech-item__icon {
		display: inline-flex;
		flex-shrink: 0;
	}

	.tech-item__name {
		font-size: 0.875rem;
		font-weight: 500;
	}

	.tech-item__fallback {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 18px;
		height: 18px;
		border-radius: 0.25rem;
		background-color: var(--color-slate-100);
		color: var(--color-mist-500);
		font-size: 10px;
		font-weight: 600;
		line-height: 1;
	}

	html.dark .tech-item__fallback {
		background-color: var(--color-slate-800);
		color: var(--color-mist-400);
	}

	@media (pointer: coarse) {
		.tech-row__label {
			padding-block: 0.875rem;
		}

		.tech-row__items {
			row-gap: 0.25rem;
		}

		.tech-item {
			padding-block: 0.875rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tech-row__label,
		.tech-row__rule,
		.tech-item {
			transition: none;
		}
	}
</style>
