---
import { ArrowUpRight } from '@lucide/svelte';
import SiteHeader from '../../components/chrome/SiteHeader.svelte';
import PageContainer from '../../components/layout/PageContainer.svelte';
import Base from '../../layouts/Base.astro';
import { loadPublished } from '../../util/emdash-content';
import { groupBookmarksByTags } from '../../util/bookmarks-page';

const bookmarksResult = await loadPublished('bookmarks');
if (Astro.cache.enabled) {
	Astro.cache.set(bookmarksResult.cacheHint);
}

const tags = groupBookmarksByTags(bookmarksResult.entries);
const lastChecked = bookmarksResult.cacheHint.lastModified?.toLocaleDateString();
---

<Base title="Bookmarks" robots="noindex, nofollow, noarchive">
	<PageContainer class="space-y-20 mt-12">
		<SiteHeader />
		<main id="main-content" class="w-full space-y-16">
			<header class="space-y-3 max-w-2xl">
				<p class="text-xs font-medium tracking-[0.2em] uppercase text-jade-700 dark:text-jade-400">
					Bookmarks
				</p>
				<h1
					class="text-3xl md:text-4xl font-semibold tracking-tight text-slate-900 dark:text-slate-100"
				>
					A loose collection of links worth keeping
				</h1>
				<p class="text-slate-600 dark:text-mist-400 leading-relaxed">
					Tools, articles, and references I return to. Grouped by topic.
				</p>
			</header>

			{
				tags.length > 0 && (
					<section>
						<div class="flex items-baseline justify-between mb-6 pb-3 border-b border-slate-200 dark:border-slate-800">
							<h2 class="text-sm font-semibold tracking-[0.15em] uppercase text-slate-700 dark:text-slate-300">
								Categories
							</h2>
							<span class="text-xs font-medium text-mist-500 dark:text-mist-400 tabular-nums">
								{tags.length}
							</span>
						</div>

						<div class="columns-1 md:columns-2 lg:columns-3 gap-4 space-y-4">
							{tags.map((tag) => (
								<div class="card card--interactive break-inside-avoid group p-5">
									<div class="flex items-baseline justify-between gap-2 mb-3 pb-3 border-b border-slate-200/70 dark:border-slate-800/70">
										<h3 class="text-[11px] font-semibold tracking-[0.15em] uppercase text-slate-600 dark:text-mist-400 group-hover:text-jade-700 dark:group-hover:text-jade-400 transition-colors">
											{tag.name}
										</h3>
										<span class="text-[10px] font-medium text-mist-500 dark:text-mist-400 tabular-nums">
											{tag.bookmarks.length}
										</span>
									</div>
									<ul class="space-y-1.5">
										{tag.bookmarks.map((bookmark) => (
											<li>
												<a
													href={bookmark.url}
													target="_blank"
													rel="noopener noreferrer"
													class="group/link inline-flex items-start gap-1.5 text-sm text-slate-700 dark:text-slate-300 hover:text-jade-700 dark:hover:text-jade-400 transition-colors rounded-xs focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-jade-700 dark:focus-visible:ring-jade-400/60"
												>
													<span class="underline underline-offset-4 decoration-slate-300 dark:decoration-slate-700 group-hover/link:decoration-jade-600/60">
														{bookmark.title}
													</span>
													<ArrowUpRight class="w-3 h-3 mt-1 opacity-0 group-hover/link:opacity-100 transition-opacity shrink-0" />
												</a>
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
					</section>
				)
			}

			{
				lastChecked && (
					<p class="text-xs text-mist-500 dark:text-mist-400 italic text-center">
						Data as of {lastChecked}
					</p>
				)
			}
		</main>
	</PageContainer>
</Base>
